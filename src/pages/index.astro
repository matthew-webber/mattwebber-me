---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalDivider from '../components/TerminalDivider.astro';
---
<BaseLayout canonicalPath="/" bodyClass="about-page">
  <main>
    <section class="home-hero">
      <h1>hi, I'm <mark>Matt</mark></h1>
    </section>

    <TerminalDivider />

    <section class="about-blurb">
      <p>
        Dev and entrepreneur. I build small, sharp tools &mdash; a Stream Deck plugin for guitar
        amps, a couple of Chrome extensions that make Facebook Marketplace bearable &mdash; and
        I write up whatever I figure out along the way.
      </p>
      <p class="about-refrain">||: travel, code, make music :||</p>

      <nav class="about-links" aria-label="Site sections">
        <a href="/products/">See what I've built <span aria-hidden="true">&rarr;</span></a>
        <a href="/thoughts/">Read what I've been thinking <span aria-hidden="true">&rarr;</span></a>
      </nav>
    </section>
  </main>
</BaseLayout>
